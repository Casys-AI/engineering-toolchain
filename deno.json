{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "lock": {
    "path": "deno.lock",
    "frozen": true
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@casys/mcp-syson",
      "jsr:@casys/mcp-build123d",
      "jsr:@casys/mcp-calculix",
      "jsr:@casys/mcp-server",
      "jsr:@casys/constraint-solver"
    ]
  },
  "imports": {
    "@casys/mcp-syson": "jsr:@casys/mcp-syson@0.6.0",
    "@casys/mcp-syson/": "jsr:@casys/mcp-syson@0.6.0/",
    "@casys/mcp-build123d": "jsr:@casys/mcp-build123d@0.4.1",
    "@casys/mcp-build123d/": "jsr:@casys/mcp-build123d@0.4.1/",
    "@casys/mcp-calculix": "jsr:@casys/mcp-calculix@0.7.0",
    "@casys/mcp-calculix/": "jsr:@casys/mcp-calculix@0.7.0/",
    "@casys/constraint-solver": "jsr:@casys/constraint-solver@0.1.0",
    "@casys/constraint-solver/": "jsr:@casys/constraint-solver@0.1.0/"
  },
  "tasks": {
    "cache": "deno cache --frozen jsr:@casys/mcp-syson@0.6.0/server jsr:@casys/mcp-build123d@0.4.1/server jsr:@casys/mcp-calculix@0.7.0/server jsr:@casys/mcp-build123d@0.4.1",
    "cache:verify": "deno eval --cached-only --frozen 'await Promise.all([import(\"jsr:@casys/mcp-syson@0.6.0/server\"), import(\"jsr:@casys/mcp-build123d@0.4.1/server\"), import(\"jsr:@casys/mcp-calculix@0.7.0/server\"), import(\"jsr:@casys/mcp-build123d@0.4.1\")])'",
    "verify:pins": "deno run --allow-read scripts/verify-pinned-versions.ts"
  }
}
